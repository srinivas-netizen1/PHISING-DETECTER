# ========================================================
# PhishGuard - Apache Server Configuration
# ========================================================

# Disable directory file listing
Options -Indexes

# Custom Error Handling
ErrorDocument 400 error.php?code=400
ErrorDocument 403 error.php?code=403
ErrorDocument 404 error.php?code=404
ErrorDocument 500 error.php?code=500

# Block direct web access to internal directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(includes|models|tests|database)(/|$) - [F,L]
</IfModule>

# Prevent direct browser access to sensitive file patterns
<FilesMatch "(\.sql|\.log|\.ini|\.env)$">
    Require all denied
</FilesMatch>

# Security Headers (if mod_headers is active)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
